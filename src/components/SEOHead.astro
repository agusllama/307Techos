---
/**
 * SEOHead.astro
 * Genera todas las meta tags, canonical URL, Open Graph, Twitter Card,
 * el bloque JSON-LD con @graph unificado y carga gtag.js async.
 *
 * Regla: todas las constantes globales vienen de src/config/site.ts.
 * og:image siempre es URL absoluta >= 1200x630px (requisito WhatsApp preview).
 * Cero corchetes de placeholder en JSON-LD ni en tags HTML.
 */
import { siteUrl, businessName, whatsappNumber, gtagId } from '../config/site';

interface CasoExitoLocal {
  modeloDetalle: string;
  barrio: string;
  problemaResuelto: string;
  resultado: string;
}

interface ArticleData {
  headline: string;
  datePublished: string;
  dateModified?: string;
  authorName?: string;
}

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  /** Ruta relativa desde la raiz del sitio. Se convierte a URL absoluta aqui. */
  ogImage?: string;
  zona?: {
    nombreZona: string;
    slug: string;
    wikidataId: string;
    tiempoLlegadaEstimado: string;
    barriosCobertura: string[];
    viasAccesoPrincipales: string[];
    casoExitoLocal: CasoExitoLocal;
  };
  isCaba?: boolean;
  isHomepage?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  article?: ArticleData;
  noindex?: boolean;
  /** Solo true en paginas que muestran una FAQ visible que coincide con el markup. */
  faq?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage = '/images/og-default.webp',
  zona,
  isCaba,
  isHomepage = false,
  breadcrumbs,
  article,
  noindex = false,
  faq = false,
} = Astro.props;

// Entorno de indexación: si PUBLIC_INDEXABLE está configurado como 'false', se bloquea la indexación para evitar canibalización en staging/preview
const isIndexableEnv = import.meta.env.PUBLIC_INDEXABLE !== 'false';
const shouldNoindex = noindex || !isIndexableEnv;

// Sin ID real no se carga gtag: evita un request invalido en produccion.
const gaMeasurementId = gtagId && !gtagId.includes('XXXX') ? gtagId : '';

// og:image siempre URL absoluta — WhatsApp no genera preview con rutas relativas
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;
const ogImageHeight = ogImage.includes('hero-split-bg') ? '800' : '630';

// Geo region segun ubicacion: CABA es AR-C, resto de GBA y La Plata es AR-B, default AR-C
const isCapital = Boolean(isCaba || zona?.slug === 'capital-federal');
const geoRegion = isCapital ? 'AR-C' : (zona ? 'AR-B' : 'AR-C');

const WIKIDATA_PEUGEOT_307 = 'https://www.wikidata.org/wiki/Q215286';

const breadcrumbItems = breadcrumbs || [
  { name: 'Inicio', url: siteUrl + '/' },
  ...(zona
    ? [
        { name: zona.nombreZona, url: siteUrl + '/' + zona.slug + '/' },
      ]
    : []),
];

const baseAreas = [
  { name: 'Ciudad Autonoma de Buenos Aires', wikidataUrl: 'https://www.wikidata.org/wiki/Q1486' },
  { name: 'La Plata',         wikidataUrl: 'https://www.wikidata.org/wiki/Q44059' },
  { name: 'Quilmes',          wikidataUrl: 'https://www.wikidata.org/wiki/Q863777' },
  { name: 'Lanus',            wikidataUrl: 'https://www.wikidata.org/wiki/Q869792' },
  { name: 'Lomas de Zamora',  wikidataUrl: 'https://www.wikidata.org/wiki/Q924670' },
  { name: 'Avellaneda',       wikidataUrl: 'https://www.wikidata.org/wiki/Q1031013' },
  { name: 'Berazategui',      wikidataUrl: 'https://www.wikidata.org/wiki/Q818465' },
  { name: 'Almirante Brown',  wikidataUrl: 'https://www.wikidata.org/wiki/Q606622' },
  { name: 'Esteban Echeverria', wikidataUrl: 'https://www.wikidata.org/wiki/Q1483844' },
  { name: 'Ezeiza',           wikidataUrl: 'https://www.wikidata.org/wiki/Q1386000' },
  { name: 'Florencio Varela', wikidataUrl: 'https://www.wikidata.org/wiki/Q1483861' },
  { name: 'La Matanza',       wikidataUrl: 'https://www.wikidata.org/wiki/Q5964293' },
  { name: 'Moron',            wikidataUrl: 'https://www.wikidata.org/wiki/Q1484196' },
  { name: 'Tres de Febrero',  wikidataUrl: 'https://www.wikidata.org/wiki/Q1484198' },
  { name: 'Ituzaingo',        wikidataUrl: 'https://www.wikidata.org/wiki/Q2289656' },
  { name: 'Vicente Lopez',    wikidataUrl: 'https://www.wikidata.org/wiki/Q1484210' },
  { name: 'San Isidro',       wikidataUrl: 'https://www.wikidata.org/wiki/Q1484206' },
  { name: 'General San Martin', wikidataUrl: 'https://www.wikidata.org/wiki/Q1484201' },
  { name: 'Tigre',            wikidataUrl: 'https://www.wikidata.org/wiki/Q828766' },
  { name: 'Pilar',            wikidataUrl: 'https://www.wikidata.org/wiki/Q2060205' },
  { name: 'Mar del Plata',    wikidataUrl: 'https://www.wikidata.org/wiki/Q52607' },
  { name: 'Pinamar',          wikidataUrl: 'https://www.wikidata.org/wiki/Q517783' },
  { name: 'Villa Gesell',     wikidataUrl: 'https://www.wikidata.org/wiki/Q991574' },
  { name: 'Partido de La Costa', wikidataUrl: 'https://www.wikidata.org/wiki/Q1038912' },
  { name: 'San Bernardo del Tuyu', wikidataUrl: 'https://www.wikidata.org/wiki/Q7413471' },
  { name: 'Mar de Ajo',       wikidataUrl: 'https://www.wikidata.org/wiki/Q991680' },
  { name: 'Interior de Buenos Aires', wikidataUrl: 'https://www.wikidata.org/wiki/Q4475' },
];

const areaServed = baseAreas.map((a) => ({
  '@type': 'AdministrativeArea',
  name: a.name,
  sameAs: a.wikidataUrl,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    // 1. AutoRepair / LocalBusiness
    {
      '@type': ['AutoRepair', 'LocalBusiness'],
      '@id': siteUrl + '/#business',
      name: businessName,
      description: 'Especialistas en retapizado y reparación de techos caídos (headliner) de Peugeot 307 a domicilio. Cubrimos CABA, Gran Buenos Aires, La Plata, Costa Atlántica e Interior de Buenos Aires.',
      url: siteUrl,
      telephone: '+' + whatsappNumber,
      currenciesAccepted: 'ARS',
      paymentAccepted: 'Cash, Transferencia bancaria, Mercado Pago',
      areaServed: areaServed,
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],
          opens: '08:00',
          closes: '19:00',
        },
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: '+' + whatsappNumber,
        availableLanguage: 'Spanish',
      },
    },
    // 2. Service
    {
      '@type': 'Service',
      '@id': siteUrl + '/#service',
      name: 'Reparación y Retapizado de Techo Caído Peugeot 307 a Domicilio',
      provider: { '@id': siteUrl + '/#business' },
      serviceType: 'Auto Interior Repair',
      about: { '@type': 'Thing', name: 'Peugeot 307', sameAs: WIKIDATA_PEUGEOT_307 },
      description: 'Servicio especializado de retapizado de techo interior para Peugeot 307 Hatchback (variantes 3 y 5 puertas, con y sin techo solar).',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios para Peugeot 307',
        itemListElement: [
          {
            '@type': 'Offer',
            name: 'Retapizado Techo Peugeot 307',
            description: 'Para variantes Peugeot 307 Hatchback (3 y 5 puertas, con y sin techo solar). Incluye desmontaje, remoción de espuma original degradada, aplicación de tela 100% fibra de poliéster con adhesivo de alta temperatura y reinstalación.',
            priceCurrency: 'ARS',
          },
        ],
      },
    },
    // 3. HowTo (solo en landing principal y zonas donde se detalla el proceso)
    ...((isHomepage || Boolean(zona))
      ? [
          {
            '@type': 'HowTo',
            '@id': siteUrl + '/#howto',
            name: 'Proceso de Retapizado de Techo Caído Peugeot 307',
            description: 'Procedimiento técnico para reparar el headliner del Peugeot 307 a domicilio.',
            estimatedCost: { '@type': 'MonetaryAmount', currency: 'ARS' },
            tool: [
              { '@type': 'HowToTool', name: 'Pistola de calor industrial' },
              { '@type': 'HowToTool', name: 'Adhesivo de contacto de alta temperatura para tapicería' },
              { '@type': 'HowToTool', name: 'Rodillo de presión para tapicería' },
              { '@type': 'HowToTool', name: 'Espátula de plástico' },
              { '@type': 'HowToTool', name: 'Tela de tapicería automotriz 100% fibra de poliéster' },
            ],
            step: [
              {
                '@type': 'HowToStep',
                position: 1,
                name: 'Desmontaje de accesorios y plafones',
                text: 'Se retiran los plafones de iluminación interior, el espejo retrovisor, los parasoles y las agarraderas. Cada pieza se etiqueta y guarda en orden para garantizar la reinstalación correcta.',
              },
              {
                '@type': 'HowToStep',
                position: 2,
                name: 'Remoción del residuo de espuma original degradada',
                text: 'Con espátula y solvente desengrasante, se elimina la espuma original pulverizada adherida al sustrato rígido del techo. Cualquier residuo impide la adhesión correcta de la nueva tela.',
              },
              {
                '@type': 'HowToStep',
                position: 3,
                name: 'Aplicación de tela 100% fibra de poliéster con adhesivo de alta temperatura',
                text: 'Se aplica adhesivo de contacto de alta temperatura en el sustrato y en la nueva tela 100% fibra de poliéster automotriz. Se presiona desde el centro hacia los bordes para una fijación uniforme y duradera.',
              },
              {
                '@type': 'HowToStep',
                position: 4,
                name: 'Reinstalación y chequeo de fijaciones',
                text: 'Se reinstalan todos los accesorios en el orden inverso al desmontaje. Se verifica el correcto cierre de cada plafón, el funcionamiento de la iluminación interior y la alineación OEM de molduras y parasoles.',
              },
            ],
          },
        ]
      : []),
    // 4. FAQPage (solo si la pagina muestra esas preguntas)
    ...(faq ? [{
      '@type': 'FAQPage',
      '@id': siteUrl + '/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Cuánto tiempo demora el trabajo?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Menos de 2 horas (según versión con o sin techo solar). Lo hacemos y lo terminamos en el día para que no te quedes a pie.',
          },
        },
        {
          '@type': 'Question',
          name: '¿El adhesivo resiste el calor del verano?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sí. Utilizamos exclusivamente adhesivo de contacto de grado automotriz diseñado para soportar calor extremo y humedad sin volver a despegarse.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Qué espacio se necesita en el domicilio?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Muy poco. Solo necesitamos el espacio suficiente para poder abrir las puertas y el baúl por completo. Trabajamos donde tengas el auto: en la calle, en el trabajo, cochera o estacionamiento.',
          },
        },
        {
          '@type': 'Question',
          name: '¿El servicio cuenta con garantía?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sí, te damos una garantía escrita por 12 meses.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Qué medios de pago aceptan?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Aceptamos efectivo, transferencia bancaria y Mercado Pago. Abonás recién cuando el trabajo está terminado y revisado a tu total conformidad.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Puedo usar el auto inmediatamente después?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sí, el auto queda listo para manejar apenas nos vamos, sin tiempos extra de secado.',
          },
        },
      ],
    }] : []),
    // 5. BreadcrumbList (solo si no es la home y hay al menos 2 items)
    ...(!isHomepage && breadcrumbItems.length > 1
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': canonicalUrl + '#breadcrumb',
            itemListElement: breadcrumbItems.map((item, index) => ({
              '@type': 'ListItem',
              position: index + 1,
              name: item.name,
              item: item.url,
            })),
          },
        ]
      : []),
    // 6. BlogPosting (si corresponde)
    ...(article
      ? [
          {
            '@type': 'BlogPosting',
            '@id': canonicalUrl + '#article',
            headline: article.headline,
            description: description,
            datePublished: article.datePublished,
            dateModified: article.dateModified || article.datePublished,
            mainEntityOfPage: {
              '@type': 'WebPage',
              '@id': canonicalUrl,
            },
            author: {
              '@type': 'Person',
              name: article.authorName || 'Técnico Especialista 307 Techos',
            },
            publisher: {
              '@id': siteUrl + '/#business',
            },
            image: ogImageAbsolute,
          },
        ]
      : []),
  ],
};

const jsonLdString = JSON.stringify(jsonLd);
---

<!-- Preload LCP Hero Image en Homepage y Zonas para carga ultra veloz -->
{(isHomepage || Boolean(zona)) && (
  <>
    <link rel="preload" as="image" href="/images/hero-split-bg-mobile.webp" media="(max-width: 640px)" type="image/webp" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/hero-split-bg.webp" media="(min-width: 641px)" type="image/webp" fetchpriority="high" />
  </>
)}

<!-- Google tag (gtag.js) - unico script de terceros permitido, cargado async -->
{gaMeasurementId && (
  <>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script async src={"https://www.googletagmanager.com/gtag/js?id=" + gaMeasurementId}></script>
    <script define:vars={{ gaMeasurementId }} is:inline>
      window.dataLayer = window.dataLayer || [];
      // eslint-disable-next-line no-inner-declarations
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaMeasurementId);
    </script>
  </>
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph (og:image siempre URL absoluta >= 1200x630) -->
<meta property="og:type" content={article ? 'article' : 'website'} />
{article && (
  <>
    <meta property="article:published_time" content={article.datePublished} />
    <meta property="article:modified_time" content={article.dateModified || article.datePublished} />
    <meta property="article:author" content={article.authorName || 'Técnico Especialista 307 Techos'} />
  </>
)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageAbsolute} />
<meta property="og:image:type" content={ogImageAbsolute.endsWith('.webp') ? 'image/webp' : 'image/jpeg'} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content={ogImageHeight} />
<meta property="og:locale" content="es_AR" />
<meta property="og:site_name" content={businessName} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbsolute} />

<!-- Robots -->
<meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

<!-- Geo Meta -->
<meta name="geo.region" content={geoRegion} />
<meta name="geo.placename" content={zona ? zona.nombreZona : 'Buenos Aires'} />

<!-- JSON-LD Structured Data @graph unificado -->
<script type="application/ld+json" set:html={jsonLdString}></script>