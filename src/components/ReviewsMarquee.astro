---
import { getActiveReviews, formatReviewComment, isValidReview, type Review } from '../data/reviews';

interface Props {
  reviews?: Review[];
  class?: string;
}

const props = Astro.props;
const baseReviews = props.reviews
  ? props.reviews
      .filter(isValidReview)
      .map((r) => ({
        ...r,
        comment: r.comment ? formatReviewComment(r.comment) : '',
      }))
      .slice(0, 10)
  : getActiveReviews();

// Duplicate reviews to create seamless infinite loop for -50% CSS transform
const displayReviews = [...baseReviews, ...baseReviews];
---

<section
  class={`bg-[#F3F4F6] border-b border-[#E5E7EB] pt-3 pb-3.5 sm:pt-4 sm:pb-5 overflow-hidden ${props.class ?? ''}`}
  aria-label="Opiniones de clientes"
>
  <!-- Micro-badge de confianza -->
  <div class="max-w-5xl mx-auto px-4 mb-2.5 sm:mb-3 flex justify-center">
    <div class="inline-flex items-center gap-2 bg-[#FFFFFF] border border-[#E5E7EB] px-3 py-1 rounded-full text-xs font-bold text-[#111827]">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" style="aspect-ratio: 1/1;" class="shrink-0">
        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17Z"/>
        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24Z"/>
        <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15Z"/>
        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98Z"/>
      </svg>
      <div class="flex items-center gap-0.5" aria-label="Calificación 4.9 de 5">
        <span class="text-[#FBBC05] text-[13px] leading-none">★</span>
        <span class="text-[#111827]">4.9</span>
      </div>
      <span class="text-[#9CA3AF] text-[10px] leading-none" aria-hidden="true">•</span>
      <span class="text-[#4B5563] font-medium text-[11px] sm:text-xs">Valoraciones de clientes en Google</span>
    </div>
  </div>

  <!-- Contenedor del Marquee con máscara de desvanecimiento lateral -->
  <div class="reviews-marquee-container w-full overflow-hidden">
    <div class="reviews-marquee-track flex gap-3 w-max">
      {displayReviews.map((review) => (
        <article
          class="review-card w-[260px] sm:w-[280px] shrink-0 bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-3 sm:p-3.5 flex flex-col justify-start min-h-[115px]"
          aria-label={`Reseña de ${review.authorName}`}
        >
          <!-- Fila Superior: Avatar + Nombre + Fecha + Logo G -->
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2 min-w-0">
              {review.avatarUrl ? (
                <img
                  src={review.avatarUrl}
                  alt=""
                  width="32"
                  height="32"
                  class="w-7 h-7 sm:w-8 sm:h-8 rounded-full object-cover shrink-0 select-none"
                  loading="lazy"
                  decoding="async"
                  style="aspect-ratio: 1 / 1;"
                />
              ) : (
                <div
                  class="w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-white text-xs font-black shrink-0 select-none"
                  style={`background-color: ${review.avatarColor ?? '#4285F4'};`}
                  aria-hidden="true"
                >
                  {review.authorName.trim().charAt(0).toUpperCase()}
                </div>
              )}
              <div class="min-w-0">
                <p class="font-bold text-xs sm:text-[13px] text-[#111827] truncate leading-tight">
                  {review.authorName}
                </p>
                {review.date && (
                  <p class="text-[10px] sm:text-[11px] text-[#4B5563] leading-none mt-0.5">
                    {review.date}
                  </p>
                )}
              </div>
            </div>
            <!-- Logo oficial Google 'G' -->
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" style="aspect-ratio: 1/1;" class="shrink-0 opacity-80">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17Z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24Z"/>
              <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15Z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98Z"/>
            </svg>
          </div>

          <!-- Estrellas -->
          <div class="flex items-center gap-0.5 mb-1.5" aria-label={`${review.rating} de 5 estrellas`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                width="13"
                height="13"
                viewBox="0 0 20 20"
                fill={i < review.rating ? '#FBBC05' : '#E5E7EB'}
                aria-hidden="true"
                style="aspect-ratio: 1/1;"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Comentario (omitido limpiamente si no tiene texto) -->
          {review.comment && review.comment.trim() !== '' && (
            <p class="text-xs text-[#4B5563] leading-relaxed line-clamp-4">
              {review.comment}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .reviews-marquee-container {
    mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 24px), transparent 100%);
  }

  .reviews-marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: marquee 35s linear infinite;
  }

  @media (hover: hover) and (pointer: fine) {
    .reviews-marquee-track:hover {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-marquee-track {
      animation: none;
      overflow-x: auto;
      max-width: 100%;
      scroll-snap-type: x mandatory;
    }
    .reviews-marquee-container {
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
