---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteUrl, whatsappNumber, businessName } from '../../config/site';
import { waClickHandler } from '../../lib/tracking';

const zonas = await getCollection('zonas');

const canonicalUrl = siteUrl + '/reparacion-techo-peugeot-307/';
const title = 'Zonas de Cobertura | Techo Peugeot 307 a Domicilio';
const description = 'Retapizado de techo Peugeot 307 donde tengas el auto en menos de 2 horas. Cobertura en 20 zonas de CABA, GBA y La Plata.';

const hubWaUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent('Hola! Quiero consultar presupuesto para reparar el techo de mi Peugeot 307 a domicilio.');
const hubCTAHandler = waClickHandler('zonas-hub', 'hero');

const breadcrumbs = [
  { name: 'Inicio', url: siteUrl + '/' },
  { name: 'Reparacion Techo 307', url: canonicalUrl },
];

const regiones = [
  {
    nombre: 'CABA y Zona Norte',
    slugs: ['capital-federal', 'vicente-lopez', 'san-isidro', 'general-san-martin', 'tigre', 'pilar'],
  },
  {
    nombre: 'Zona Oeste',
    slugs: ['la-matanza', 'moron', 'tres-de-febrero', 'ituzaingo'],
  },
  {
    nombre: 'Zona Sur y Gran La Plata',
    slugs: ['avellaneda', 'lanus', 'lomas-de-zamora', 'quilmes', 'berazategui', 'almirante-brown', 'esteban-echeverria', 'ezeiza-canning', 'florencio-varela', 'la-plata'],
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  breadcrumbs={breadcrumbs}
  showHeader={true}
>
  <!-- Cabecera de la Página Hub -->
  <section class="bg-[#111827] text-white py-12 sm:py-16 border-b border-[#374151]">
    <div class="max-w-5xl mx-auto px-4">
      <nav aria-label="Miga de pan" class="mb-4">
        <ol class="flex items-center gap-2 text-xs text-[#9CA3AF]">
          <li><a href="/" class="hover:text-white transition-colors py-1 px-2 inline-flex items-center min-h-[44px]">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white font-bold px-1" aria-current="page">Zonas de Cobertura</li>
        </ol>
      </nav>

      <h1 class="text-[30px] sm:text-4xl lg:text-5xl font-black uppercase tracking-tighter leading-[1.1] mb-4">
        Reparación de Techos Peugeot 307 a Domicilio
      </h1>

      <p class="text-sm sm:text-base text-gray-200 max-w-2xl leading-relaxed mb-6">
        Brindamos atención técnica especializada en 20 partidos y comunas de CABA, Gran Buenos Aires y Gran La Plata. Acudimos directamente donde tengas el auto (en la calle, en el trabajo, cochera o estacionamiento) para retapizar el techo caído en menos de 2 horas.
      </p>

      <a
        href={hubWaUrl}
        class="cta-whatsapp text-sm sm:text-base px-6 py-3.5 inline-flex items-center justify-center gap-2 text-center leading-snug w-full sm:w-auto min-h-[44px]"
        target="_blank"
        rel="noopener noreferrer"
        onclick={hubCTAHandler}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>Cotizar servicio por WhatsApp</span>
      </a>
    </div>
  </section>

  <!-- Grilla de Cobertura por Regiones -->
  <section class="max-w-5xl mx-auto px-4 py-12 lg:py-16">
    <div class="mb-10">
      <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
        Zonas de Atención Técnica a Domicilio
      </h2>
      <p class="text-base text-[#4B5563] max-w-2xl leading-relaxed">
        Seleccioná tu localidad para conocer los tiempos de respuesta técnica, vías principales de acceso y particularidades operativas de cada zona.
      </p>
    </div>

    <div class="space-y-12">
      {regiones.map((region) => {
        const zonasRegion = region.slugs
          .map((slug) => zonas.find((z) => z.data.slug === slug || z.id.replace('.md', '') === slug))
          .filter(Boolean);

        return (
          <div>
            <h3 class="text-lg sm:text-xl font-black uppercase tracking-tight text-[#111827] pb-2 mb-4 border-b border-[#111827]">
              {region.nombre}
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {zonasRegion.map((z) => {
                const d = z!.data;
                const zonaSlug = d.slug || z!.id.replace('.md', '');
                return (
                  <a
                    href={"/reparacion-techo-peugeot-307/" + zonaSlug + "/"}
                    class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-4 hover:border-[#111827] transition-colors flex flex-col justify-between group min-h-[110px]"
                  >
                    <div>
                      <p class="font-black text-base uppercase tracking-tight text-[#111827] group-hover:underline mb-1">
                        {d.nombreZona}
                      </p>
                      <p class="text-xs text-[#4B5563] line-clamp-2 leading-relaxed">
                        {d.barriosCobertura.slice(0, 4).join(', ')} y alrededores.
                      </p>
                    </div>
                    <div class="pt-3 mt-3 border-t border-[#F3F4F6] flex items-center justify-between text-xs text-[#4B5563]">
                      <span>Llegada: {d.tiempoLlegadaEstimado}</span>
                      <span class="font-bold text-[#111827] group-hover:underline">Ver zona</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Banner Informativo de Materiales y Garantía -->
  <section class="bg-[#FFFFFF] border-y border-[#E5E7EB] py-12">
    <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-3 gap-6 text-sm text-[#4B5563]">
      <div class="border border-[#E5E7EB] rounded-sm p-5">
        <p class="font-black text-base uppercase tracking-tight text-[#111827] mb-2">Exclusivo Peugeot 307 Hatchback</p>
        <p class="leading-relaxed text-xs">Atendemos modelos de 3 y 5 puertas, tanto con techo ciego estándar como con techo solar corredizo de vidrio.</p>
      </div>
      <div class="border border-[#E5E7EB] rounded-sm p-5">
        <p class="font-black text-base uppercase tracking-tight text-[#111827] mb-2">Tela 100% Fibra de Poliéster</p>
        <p class="leading-relaxed text-xs">No colocamos tela foamizada con gomaespuma. La tela nueva no se desintegra con el calor ni la humedad estival.</p>
      </div>
      <div class="border border-[#E5E7EB] rounded-sm p-5">
        <p class="font-black text-base uppercase tracking-tight text-[#111827] mb-2">Garantía Escrita de 12 Meses</p>
        <p class="leading-relaxed text-xs">Adhesivo de contacto de grado industrial que tolera más de 110 °C de temperatura bajo sol directo.</p>
      </div>
    </div>
  </section>
</Layout>
