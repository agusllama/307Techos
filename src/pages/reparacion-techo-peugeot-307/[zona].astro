---
/**
 * [zona].astro
 * Pagina de destino dinamica por zona geografica.
 * Regla DOM: cero divs envolventes innecesarios (anti-div-soup).
 * Semantica nativa completa para table, breadcrumb y details/summary.
 * Todos los CTAs de WhatsApp usan waClickHandler() — sin logica inline duplicada.
 * Cero placeholders crudos [COMPLETAR] en el HTML renderizado.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReviewsMarquee from '../../components/ReviewsMarquee.astro';
import { siteUrl, whatsappNumber } from '../../config/site';
import { waClickHandler } from '../../lib/tracking';

export async function getStaticPaths() {
  const zonas = await getCollection('zonas');
  return zonas.map((zona) => ({
    params: { zona: zona.data.slug },
    props: { zona },
  }));
}

const { zona } = Astro.props;
const { Content } = await render(zona);
const d = zona.data;

const canonicalUrl = siteUrl + '/reparacion-techo-peugeot-307/' + d.slug + '/';
const heroWaUrl         = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent('Hola! Vi el servicio en la web y consulto para retapizar el techo de mi Peugeot 307 a domicilio en ' + d.nombreZona + '.');
const antesDespuesWaUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent('Hola! Vi las fotos del retapizado del Peugeot 307 y quiero pedir presupuesto para hacerlo en ' + d.nombreZona + '.');
const finalWaUrl        = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent('Hola! Quiero coordinar un turno para retapizar el techo de mi Peugeot 307 en ' + d.nombreZona + '.');

// Handlers de tracking (sin duplicar logica inline)
const heroCTAHandler         = waClickHandler(d.nombreZona, 'hero');
const antesDespuesCTAHandler = waClickHandler(d.nombreZona, 'antes-despues');
const finalCTAHandler        = waClickHandler(d.nombreZona, 'final');

const title = 'Techo Caído Peugeot 307 en ' + d.nombreZona + ' a Domicilio';
const description = 'Retapizado de techo Peugeot 307 en ' + d.nombreZona + ' donde tengas el auto. Listo en menos de 2 horas. Hatchback 3 y 5 puertas.';

// Verificacion estricta para omitir casos de exito si contienen placeholders
const isCasoExitoValido = Boolean(
  d.casoExitoLocal &&
  d.casoExitoLocal.barrio &&
  !d.casoExitoLocal.barrio.includes('[COMPLETAR]') &&
  d.casoExitoLocal.resultado &&
  !d.casoExitoLocal.resultado.includes('[COMPLETAR]') &&
  !d.casoExitoLocal.problemaResuelto?.includes('[COMPLETAR]')
);

const isCaba = d.slug === 'capital-federal';

const todasLasZonas = await getCollection('zonas');

// Misma agrupacion que el hub y la home. Se usan las 3 zonas mas cercanas
// dentro de la region para enlazado interno contextual.
const regiones = [
  { nombre: 'CABA y Zona Norte', slugs: ['capital-federal', 'vicente-lopez', 'san-isidro', 'general-san-martin', 'tigre', 'pilar'] },
  { nombre: 'Zona Oeste', slugs: ['la-matanza', 'moron', 'tres-de-febrero', 'ituzaingo'] },
  { nombre: 'Zona Sur y Gran La Plata', slugs: ['avellaneda', 'lanus', 'lomas-de-zamora', 'quilmes', 'berazategui', 'almirante-brown', 'esteban-echeverria', 'ezeiza-canning', 'florencio-varela', 'la-plata'] },
];
const regionActual = regiones.find((r) => r.slugs.includes(d.slug));
const indiceZona = regionActual ? regionActual.slugs.indexOf(d.slug) : -1;
const zonasRelacionadas = regionActual && indiceZona >= 0
  ? regionActual.slugs
      .filter((slug) => slug !== d.slug)
      .sort((a, b) => Math.abs(regionActual.slugs.indexOf(a) - indiceZona) - Math.abs(regionActual.slugs.indexOf(b) - indiceZona))
      .slice(0, 3)
      .map((slug) => todasLasZonas.find((z) => z.data.slug === slug))
      .filter((z): z is NonNullable<typeof z> => Boolean(z))
  : [];

const puntosBeneficio = isCaba
  ? [
      {
        titulo: 'Cero tráfico y traslados',
        descripcion: 'No pierdas 2 horas cruzando la ciudad para dejar el auto en un taller. Nosotros vamos a tu puerta.',
      },
      {
        titulo: 'Donde tengas el auto',
        descripcion: 'Solo necesitamos espacio para abrir las puertas laterales y el baúl. Trabajamos en la calle, en el trabajo, cochera o estacionamiento.',
      },
      {
        titulo: 'No te quedás a pie',
        descripcion: 'Nosotros dejamos el techo como 0km en menos de 2 horas.',
      },
    ]
  : [
      {
        titulo: 'Sin mover el auto',
        descripcion: 'Evitá el riesgo y la incomodidad de manejar por la avenida o la autopista con la tela colgando sobre tu cabeza.',
      },
      {
        titulo: 'Donde tengas el auto',
        descripcion: 'Vamos directo a donde tengas el auto (calle, trabajo o cochera). Solo necesitamos menos de 2 horas para dejar tu techo como 0km.',
      },
      {
        titulo: 'Chau talleres lentos',
        descripcion: 'Te ahorrás el dolor de cabeza de dejar el auto tirado días enteros en un taller de barrio.',
      },
    ];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} zona={d} faq={true}>

  <!-- HERO MINIMALISTA: Fondo con la imagen real de Antes y Después + Overlay + Tipografía blanca + CTA WhatsApp -->
  <section class="relative min-h-[calc(100vh-130px)] min-h-[calc(100dvh-130px)] md:min-h-screen flex items-center justify-center overflow-hidden bg-[#111827] text-white border-b border-[#E5E7EB]">
    <!-- Imagen de fondo optimizada con carga prioritaria LCP -->
    <picture class="absolute inset-0 w-full h-full pointer-events-none">
      <source media="(max-width: 640px)" srcset="/images/hero-split-bg-mobile.webp" type="image/webp" />
      <img
        src="/images/hero-split-bg.webp"
        alt={"Antes y después del retapizado de techo Peugeot 307 en " + d.nombreZona}
        width="1200"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center"
        style="aspect-ratio: 1200 / 800;"
      />
    </picture>

    <!-- Overlay con scrim funcional para legibilidad impecable y visualización del split antes/después -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#111827]/40 via-[#111827]/65 to-[#111827]/85 backdrop-blur-[0.5px]"></div>

    <!-- Indicadores discretos de Antes y Después sobre el fondo -->
    <div class="absolute top-3 sm:top-4 inset-x-3 sm:inset-x-4 flex justify-between items-center gap-2 pointer-events-none z-10">
      <span class="bg-black/60 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-sm border border-white/20 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white/80 whitespace-nowrap shrink-0">Antes: Caído</span>
      <span class="bg-black/60 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-sm border border-white/20 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white/80 whitespace-nowrap shrink-0">Después: Restaurado</span>
    </div>

    <!-- Contenido Minimalista Centrado -->
    <div class="relative z-10 max-w-2xl mx-auto px-4 py-16 sm:py-20 text-center flex flex-col items-center">
      <nav aria-label="Miga de pan" class="mb-4 w-full">
        <ol class="flex flex-wrap items-center justify-center gap-1.5 text-[11px] sm:text-xs text-gray-300">
          <li><a href="/" class="hover:text-white transition-colors py-1 px-1.5 inline-flex items-center min-h-[44px]">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/reparacion-techo-peugeot-307/" class="hover:text-white transition-colors py-1 px-1.5 inline-flex items-center min-h-[44px]">Zonas</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white font-bold px-1" aria-current="page">{d.nombreZona}</li>
        </ol>
      </nav>

      <h1 class="text-[30px] sm:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-[1.08] mb-4 text-white drop-shadow-sm">
        Techo Caído del Peugeot 307 en {d.nombreZona}
      </h1>

      <p class="text-sm sm:text-base text-gray-200 mb-6 max-w-lg leading-relaxed font-normal">
        Servicio especializado a domicilio en {d.nombreZona}. Retapizado donde tengas el auto (calle, trabajo o cochera) en menos de 2 horas con materiales que soportan calor extremo y humedad sin despegarse.
      </p>

      <!-- Escasez pegada al botón -->
      <p class="text-xs font-bold uppercase tracking-wider text-white/90 mb-2.5 flex items-center justify-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-[#25D366] inline-block"></span>
        <span>Solo 6 turnos por semana</span>
      </p>

      <a
        href={heroWaUrl}
        class="cta-whatsapp text-sm sm:text-base px-6 sm:px-8 py-3.5 sm:py-4 w-full sm:w-auto mb-3.5 text-center leading-snug"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={"Contactar por WhatsApp para reparacion en " + d.nombreZona}
        onclick={heroCTAHandler}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>Cotizar por WhatsApp con foto del techo</span>
      </a>

      <!-- Mitigador de riesgo pegado debajo del botón -->
      <p class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-white mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#25D366] shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Garantía escrita de 12 meses</span>
      </p>

      <!-- Reassurance estilo minimalista debajo del boton -->
      <p class="text-[11px] sm:text-xs text-gray-300 font-medium tracking-tight">
        Atención en {d.nombreZona}. Donde tengas el auto en menos de 2 horas, con materiales resistentes a calor extremo y humedad.
      </p>
    </div>
  </section>

  <!-- MARQUEE DE RESEÑAS / SOCIAL PROOF GOOGLE MAPS -->
  <ReviewsMarquee />

  <!-- TRANSFORMACION VISUAL: ANTES VS DESPUES -->
  <section class="py-12 lg:py-16 bg-[#FFFFFF] border-b border-[#E5E7EB]">
    <div class="max-w-5xl mx-auto px-4">
      <div class="mb-8">
        <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
          Tu Techo como 0km en {d.nombreZona}
        </h2>
        <p class="text-base text-[#4B5563] max-w-3xl leading-relaxed">
          El desprendimiento de la tela del techo en el Peugeot 307 en {d.nombreZona} ocurre por la degradacion natural de la espuma de fabrica bajo el calor. La solucion profesional a domicilio reemplaza la tela completa por material nuevo automotriz fijado con adhesivo resistente a altas temperaturas sin mover tu auto.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <!-- Tarjeta Antes -->
        <div class="border border-[#E5E7EB] bg-[#F3F4F6] rounded-sm flex flex-col justify-between overflow-hidden">
          <img
            src="/images/techo-antes-caido.webp"
            alt={"Techo caido de Peugeot 307 antes de reparar en " + d.nombreZona}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover aspect-[16/9] border-b border-[#E5E7EB]"
            style="aspect-ratio: 16 / 9;"
          />
          <div class="p-4 sm:p-5">
            <h3 class="text-xs font-black uppercase tracking-tight text-[#111827] mb-1.5">
              Antes: Tela suelta y polvillo naranja
            </h3>
            <p class="text-sm text-[#4B5563] leading-relaxed">
              La espuma de fábrica se pudre con el calor y empieza a caer sobre tu cabeza, ensuciando tu ropa y los asientos. Peor aún, la tela colgando te bloquea la vista del espejo retrovisor mientras manejás. Es una molestia constante y un peligro para tu seguridad diaria.
            </p>
          </div>
        </div>

        <!-- Tarjeta Después -->
        <div class="border border-[#111827] bg-[#FFFFFF] rounded-sm flex flex-col justify-between overflow-hidden">
          <img
            src="/images/techo-despues-restaurado.webp"
            alt={"Techo de Peugeot 307 restaurado con acabado OEM en " + d.nombreZona}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover aspect-[16/9] border-b border-[#E5E7EB]"
            style="aspect-ratio: 16 / 9;"
          />
          <div class="p-4 sm:p-5">
            <h3 class="text-xs font-black uppercase tracking-tight text-[#111827] mb-1.5">
              Después: Interior tapizado y como salido de fábrica
            </h3>
            <p class="text-sm text-[#4B5563] leading-relaxed">
              Removemos la tela vieja y colocamos material automotriz 100% nuevo. El calce queda perfecto, firme, respetando luces, agarres y parasoles. Te subís al auto, mirás para arriba y el interior vuelve a verse exactamente como un 0km.
            </p>
          </div>
        </div>
      </div>

      <!-- TABLA TECNICA SEMANTICA DE COMPARACION -->
      <div class="pt-8 border-t border-[#E5E7EB]">
        <h3 class="text-[20px] font-black uppercase tracking-tighter text-[#111827] mb-3">
          Comparativa técnica de soluciones para el techo caído
        </h3>
        <p class="text-sm text-[#4B5563] mb-6 max-w-2xl leading-relaxed">
          Frente al desprendimiento de la tela del techo del Peugeot 307 existen diferentes alternativas de reparacion. La siguiente tabla compara de manera objetiva los aspectos clave.
        </p>
      
      <!-- INDICADOR INDUSTRIAL DE DESPLAZAMIENTO MOBILE -->
      <div class="flex items-center justify-between text-[11px] text-[#4B5563] mb-2 md:hidden">
        <span class="flex items-center gap-1.5 font-medium">
          <span class="inline-block w-1.5 h-1.5 bg-[#25D366] rounded-full"></span>
          Deslizá para ver otras opciones
        </span>
        <span class="text-[10px] text-[#4B5563] uppercase tracking-wider font-semibold">Comparativa técnica</span>
      </div>

      <!-- TABLA TÉCNICA COMPARATIVA (Responsive Mobile-First con 1° Columna Sticky) -->
      <div
        tabindex="0"
        role="region"
        aria-label="Comparativa técnica de soluciones para techo Peugeot 307"
        class="overflow-x-auto border border-[#E5E7EB] rounded-sm bg-[#FFFFFF] focus:outline-none focus:ring-1 focus:ring-[#111827]"
      >
        <table class="w-full text-left text-xs sm:text-sm border-separate border-spacing-0">
          <caption class="sr-only">Comparativa técnica de soluciones para techo caído Peugeot 307</caption>
          <thead class="bg-[#111827] text-[#FFFFFF] text-xs uppercase tracking-tight">
            <tr>
              <th scope="col" class="sticky left-0 z-20 bg-[#111827] text-[#FFFFFF] p-3 sm:p-4 font-black border-b border-r border-[#374151] min-w-[130px] sm:min-w-[160px]">
                Criterio técnico
              </th>
              <th scope="col" class="p-3 sm:p-4 font-black border-b border-r border-[#374151] bg-[#1F2937] text-[#25D366] min-w-[211px] sm:min-w-[210px]">
                Especializado 307 Techos® a Domicilio
              </th>
              <th scope="col" class="p-3 sm:p-4 font-bold border-b border-r border-[#374151] min-w-[170px] sm:min-w-[190px]">
                Tapicería Tradicional
              </th>
              <th scope="col" class="p-3 sm:p-4 font-bold border-b border-[#374151] min-w-[170px] sm:min-w-[190px]">
                Solución Casera
              </th>
            </tr>
          </thead>
          <tbody class="text-xs sm:text-sm text-[#4B5563]">
            <tr>
              <th scope="row" class="sticky left-0 z-10 bg-[#FFFFFF] p-3 sm:p-4 font-bold text-[#111827] border-b border-r border-[#E5E7EB]">
                Adhesivo y resistencia térmica
              </th>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">
                Adhesivo de contacto de alta temperatura (soporta más de 110°C)
              </td>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB]">
                Cemento de contacto universal; resistencia térmica media
              </td>
              <td class="p-3 sm:p-4 border-b border-[#E5E7EB]">
                Pegamento común en aerosol; se despega con calor solar (&gt;45°C)
              </td>
            </tr>
            <tr>
              <th scope="row" class="sticky left-0 z-10 bg-[#FFFFFF] p-3 sm:p-4 font-bold text-[#111827] border-b border-r border-[#E5E7EB]">
                Material de tapizado
              </th>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">
                Tela automotriz 100% fibra de poliéster (sin capa de gomaespuma degradable)
              </td>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB]">
                Tela genérica sin espesor calibrado para molduras de Peugeot
              </td>
              <td class="p-3 sm:p-4 border-b border-[#E5E7EB]">
                Reutiliza la tela vieja manchada con residuos de goma degradada
              </td>
            </tr>
            <tr>
              <th scope="row" class="sticky left-0 z-10 bg-[#FFFFFF] p-3 sm:p-4 font-bold text-[#111827] border-b border-r border-[#E5E7EB]">
                Tiempo sin auto y traslado
              </th>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">
                Servicio en el día donde tengas el auto (calle, trabajo o cochera); listo en menos de 2 horas
              </td>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB]">
                Inmoviliza el vehículo de 2 a 5 días en taller
              </td>
              <td class="p-3 sm:p-4 border-b border-[#E5E7EB]">
                Trabajo incompleto sin desarme; dura semanas o días
              </td>
            </tr>
            <tr>
              <th scope="row" class="sticky left-0 z-10 bg-[#FFFFFF] p-3 sm:p-4 font-bold text-[#111827] border-b border-r border-[#E5E7EB]">
                Cuidado de trabas y sensores
              </th>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">
                Espátulas plásticas específicas para no marcar molduras ni romper trabas
              </td>
              <td class="p-3 sm:p-4 border-b border-r border-[#E5E7EB]">
                Desarme general sin herramientas dedicadas a Peugeot 307
              </td>
              <td class="p-3 sm:p-4 border-b border-[#E5E7EB]">
                Riesgo de quebrar grampas, plafones de luz y parasoles
              </td>
            </tr>
            <tr>
              <th scope="row" class="sticky left-0 z-10 bg-[#FFFFFF] p-3 sm:p-4 font-bold text-[#111827] border-r border-[#E5E7EB]">
                Garantía documentada
              </th>
              <td class="p-3 sm:p-4 border-r border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">
                Garantía escrita de 12 meses
              </td>
              <td class="p-3 sm:p-4 border-r border-[#E5E7EB]">
                Variable según criterio de cada taller
              </td>
              <td class="p-3 sm:p-4">
                Sin garantía; resultado desprolijo
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-8 text-center sm:text-left">
        <a
          href={antesDespuesWaUrl}
          class="cta-whatsapp text-base w-full sm:w-auto"
          target="_blank"
          rel="noopener noreferrer"
          onclick={antesDespuesCTAHandler}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
