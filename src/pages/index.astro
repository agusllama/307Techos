---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { whatsappNumber, businessName } from '../config/site';
import { waClickHandler } from '../lib/tracking';

const zonas = await getCollection('zonas');

const heroWaUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent('Hola! Vi el servicio en la web y consulto para retapizar el techo de mi Peugeot 307 a domicilio.');
const antesDespuesWaUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent('Hola! Vi las fotos del retapizado del Peugeot 307 y quiero consultar presupuesto.');
const canonicalUrl = 'https://307techos.com.ar/';
const title = 'Reparacion Techo Caido Peugeot 307 a Domicilio | CABA, GBA y La Plata | 307 Techos';
const description = 'Especialistas en retapizado de techo interior caido (headliner) del Peugeot 307 a domicilio. Cobertura en CABA, Zona Norte, Oeste, Sur y La Plata. Trabajo en el dia con adhesivo de alta temperatura.';

const heroCTAHandler = waClickHandler('home', 'hero');
const antesDespuesCTAHandler = waClickHandler('home', 'antes-despues');

const regiones = [
  {
    nombre: 'CABA y Zona Norte',
    slugs: ['capital-federal', 'vicente-lopez', 'san-isidro', 'general-san-martin', 'tigre', 'pilar'],
  },
  {
    nombre: 'Zona Oeste',
    slugs: ['la-matanza', 'moron', 'tres-de-febrero', 'ituzaingo'],
  },
  {
    nombre: 'Zona Sur y Gran La Plata',
    slugs: ['avellaneda', 'lanus', 'lomas-de-zamora', 'quilmes', 'berazategui', 'almirante-brown', 'esteban-echeverria', 'ezeiza-canning', 'florencio-varela', 'la-plata'],
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} isHomepage={true}>
  <!-- HERO MINIMALISTA: Fondo con la imagen real de Antes y Después + Overlay + Tipografía blanca + CTA WhatsApp -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#111827] text-white border-b border-[#E5E7EB]">
    <!-- Imagen de fondo optimizada con carga prioritaria LCP -->
    <picture class="absolute inset-0 w-full h-full pointer-events-none">
      <source media="(max-width: 640px)" srcset="/images/hero-split-bg-mobile.webp" type="image/webp" />
      <img
        src="/images/hero-split-bg.webp"
        alt="Antes y después del retapizado de techo Peugeot 307"
        width="1200"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center"
        style="aspect-ratio: 1200 / 800;"
      />
    </picture>

    <!-- Overlay oscuro para legibilidad impecable (estilo minimalista) -->
    <div class="absolute inset-0 bg-[#111827]/70 backdrop-blur-[0.5px]"></div>

    <!-- Indicadores discretos de Antes y Después sobre el fondo -->
    <div class="absolute top-3 sm:top-4 inset-x-3 sm:inset-x-4 flex justify-between items-center gap-2 pointer-events-none z-10">
      <span class="bg-black/60 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-sm border border-white/20 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white/80 whitespace-nowrap shrink-0">Antes: Caído</span>
      <span class="bg-black/60 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-sm border border-white/20 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white/80 whitespace-nowrap shrink-0">Después: Restaurado</span>
    </div>

    <!-- Contenido Minimalista Centrado -->
    <div class="relative z-10 max-w-2xl mx-auto px-4 py-16 sm:py-20 text-center flex flex-col items-center">
      <h1 class="text-[30px] sm:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-[1.08] mb-4 text-white drop-shadow-sm">
        Techo Caído del Peugeot 307: Retapizado a Domicilio
      </h1>
      
      <p class="text-sm sm:text-base text-gray-200 mb-6 max-w-lg leading-relaxed font-normal">
        La tela desprendida del techo interior se retapiza a nuevo en tu cochera o garaje. Sin trasladar tu auto, listo en 3 a 4 horas con materiales que soportan calor extremo y humedad sin despegarse.
      </p>

      <!-- Escasez pegada al botón -->
      <p class="text-xs font-bold uppercase tracking-wider text-white/90 mb-2.5 flex items-center justify-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-[#25D366] inline-block"></span>
        <span>Solo 6 turnos por semana</span>
      </p>

      <a
        href={heroWaUrl}
        class="cta-whatsapp text-sm sm:text-base px-6 sm:px-8 py-3.5 sm:py-4 w-full sm:w-auto mb-3.5 text-center leading-snug"
        target="_blank"
        rel="noopener noreferrer"
        onclick={heroCTAHandler}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>Cotizar por WhatsApp con foto del techo</span>
      </a>

      <!-- Mitigador de riesgo pegado debajo del botón -->
      <p class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-white mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#25D366] shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>Garantía escrita de 12 meses</span>
      </p>

      <!-- Reassurance directo debajo del botón -->
      <p class="text-[11px] sm:text-xs text-gray-300 font-medium tracking-tight">
        Presupuesto sin cargo en el día. Materiales resistentes a calor extremo y humedad, sin mover tu auto.
      </p>
    </div>
  </section>

  <!-- EVIDENCIA VISUAL: ANTES Y DESPUES + TABLA TECNICA DE COMPARACION -->
  <section class="py-12 lg:py-16 bg-[#FFFFFF] border-b border-[#E5E7EB]">
    <div class="max-w-5xl mx-auto px-4">
      <div class="mb-8">
        <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
          Tu Techo como 0km
        </h2>
        <p class="text-base text-[#4B5563] max-w-3xl leading-relaxed">
          El desprendimiento de la tela del techo en el Peugeot 307 ocurre por la degradacion natural de la espuma de fabrica bajo el calor. La solucion profesional no requiere parches temporales ni alfileres: reemplazamos la tela completa por material nuevo automotriz fijado con adhesivo resistente a altas temperaturas.
        </p>
      </div>

      <!-- Evidencia fotografica documental -->
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <!-- Tarjeta Antes -->
        <div class="border border-[#E5E7EB] bg-[#F3F4F6] rounded-sm flex flex-col justify-between overflow-hidden">
          <img
            src="/images/techo-antes-caido.webp"
            alt="Techo caido de Peugeot 307 con tela desprendida y espuma degradada"
            width="600"
            height="450"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover aspect-[4/3] border-b border-[#E5E7EB]"
            style="aspect-ratio: 4 / 3;"
          />
          <div class="p-4 sm:p-5">
            <h3 class="text-xs font-black uppercase tracking-tight text-[#111827] mb-1.5">
              Antes: Tela suelta y polvillo naranja
            </h3>
            <p class="text-sm text-[#4B5563] leading-relaxed">
              La espuma de fábrica se pudre con el calor y empieza a caer sobre tu cabeza, ensuciando tu ropa y los asientos. Peor aún, la tela colgando te bloquea la vista del espejo retrovisor mientras manejás. Es una molestia constante y un peligro para tu seguridad diaria.
            </p>
          </div>
        </div>

        <!-- Tarjeta Después -->
        <div class="border border-[#111827] bg-[#FFFFFF] rounded-sm flex flex-col justify-between overflow-hidden">
          <img
            src="/images/techo-despues-restaurado.webp"
            alt="Techo de Peugeot 307 retapizado impecable con acabado OEM de fabrica"
            width="600"
            height="450"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover aspect-[4/3] border-b border-[#E5E7EB]"
            style="aspect-ratio: 4 / 3;"
          />
          <div class="p-4 sm:p-5">
            <h3 class="text-xs font-black uppercase tracking-tight text-[#111827] mb-1.5">
              Después: Interior tapizado y como salido de fábrica
            </h3>
            <p class="text-sm text-[#4B5563] leading-relaxed">
              Removemos la tela vieja y colocamos material automotriz 100% nuevo. El calce queda perfecto, firme, respetando luces, agarres y parasoles. Te subís al auto, mirás para arriba y el interior vuelve a verse exactamente como un 0km.
            </p>
          </div>
        </div>
      </div>

      <!-- TABLA TECNICA SEMANTICA DE COMPARACION -->
      <div class="pt-8 border-t border-[#E5E7EB]">
        <h3 class="text-[20px] font-black uppercase tracking-tighter text-[#111827] mb-3">
          Comparativa técnica de soluciones para el techo caído
        </h3>
        <p class="text-sm text-[#4B5563] mb-6 max-w-2xl leading-relaxed">
          Frente al desprendimiento de la tela del techo del Peugeot 307 existen diferentes alternativas de reparacion. La siguiente tabla compara de manera objetiva los aspectos clave.
        </p>
        
        <!-- VISTA MOBILE (OPCIÓN 4: Versus Focalizado de Alto Impacto) -->
        <div class="block md:hidden space-y-4">
          <!-- Tarjeta 1: Alternativas Comunes -->
          <div class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-4 space-y-2.5">
            <span class="text-[10px] font-black uppercase tracking-widest text-[#EF4444] block">
              Alternativas Comunes (Casera o Taller General)
            </span>
            <h4 class="text-sm font-black uppercase text-[#111827]">Los Riesgos Habituales</h4>
            <ul class="space-y-2 text-xs text-[#4B5563]">
              <li class="flex items-start gap-2">
                <span class="text-[#EF4444] font-bold shrink-0">✕</span>
                <span><strong>Adhesivos comunes que se desprenden:</strong> No toleran el calor solar intenso (>45°C) y la tela vuelve a caer en semanas.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#EF4444] font-bold shrink-0">✕</span>
                <span><strong>Inmovilización prolongada:</strong> Dejar el auto de 2 a 5 días estacionado en un taller general.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#EF4444] font-bold shrink-0">✕</span>
                <span><strong>Riesgo de rotura:</strong> Desarme sin herramientas plásticas específicas para las molduras del Peugeot 307.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#EF4444] font-bold shrink-0">✕</span>
                <span><strong>Materiales genéricos:</strong> Telas sin tono ni espesor OEM, o sin garantía documentada.</span>
              </li>
            </ul>
          </div>

          <!-- Tarjeta 2: Nuestro Estándar con ® -->
          <div class="bg-[#FFFFFF] border-2 border-[#111827] rounded-sm p-4 space-y-2.5">
            <span class="text-[10px] font-black uppercase tracking-widest text-[#16A34A] block">
              Servicio Especializado 307 Techos®
            </span>
            <h4 class="text-sm font-black uppercase text-[#111827]">El Estándar a Domicilio</h4>
            <ul class="space-y-2 text-xs text-[#111827] font-medium">
              <li class="flex items-start gap-2">
                <span class="text-[#25D366] font-black shrink-0">✓</span>
                <span><strong>Adhesivo térmico de alta temperatura:</strong> Soporta más de 110°C de calor solar directo sin despegarse.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#25D366] font-black shrink-0">✓</span>
                <span><strong>En tu cochera en 3 a 4 horas:</strong> Servicio en el día en tu domicilio, sin traslados ni días sin vehículo.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#25D366] font-black shrink-0">✓</span>
                <span><strong>Tela foamizada OEM:</strong> Tono y textura original de fábrica calibrada para Peugeot 307.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#25D366] font-black shrink-0">✓</span>
                <span><strong>Herramental plástico dedicado:</strong> Desarme cuidadoso sin marcar molduras ni romper trabas.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#25D366] font-black shrink-0">✓</span>
                <span><strong>Garantía escrita de 12 meses:</strong> Respaldo documentado por fijación y adherencia.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- VISTA DESKTOP (TABLA SEMÁNTICA INDUSTRIAL COMPLETA) -->
        <div class="hidden md:block overflow-x-auto border border-[#E5E7EB] rounded-sm bg-[#FFFFFF]">
          <table class="w-full text-left text-sm border-collapse">
            <caption class="sr-only">Comparativa tecnica de soluciones para techo caido Peugeot 307</caption>
            <thead class="bg-[#111827] text-[#FFFFFF] text-xs uppercase tracking-tight">
              <tr>
                <th scope="col" class="p-3.5 sm:p-4 font-black">Criterio técnico</th>
                <th scope="col" class="p-3.5 sm:p-4 font-bold border-l border-[#374151]">Solución Casera</th>
                <th scope="col" class="p-3.5 sm:p-4 font-bold border-l border-[#374151]">Tapicería Tradicional</th>
                <th scope="col" class="p-3.5 sm:p-4 font-black border-l border-[#374151] bg-[#1F2937] text-[#25D366]">Especializado 307 Techos® a Domicilio</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#E5E7EB] text-xs sm:text-sm text-[#4B5563]">
              <tr class="hover:bg-[#F9FAFB] transition-colors">
                <th scope="row" class="p-3.5 sm:p-4 font-bold text-[#111827]">Adhesivo y resistencia térmica</th>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Pegamento común en aerosol; se despega con calor solar (>45°C)</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Cemento de contacto universal; resistencia térmica media</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">Adhesivo de contacto de alta temperatura (soporta más de 110°C)</td>
              </tr>
              <tr class="hover:bg-[#F9FAFB] transition-colors">
                <th scope="row" class="p-3.5 sm:p-4 font-bold text-[#111827]">Material de tapizado</th>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Reutiliza la tela vieja manchada con residuos de goma degradada</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Tela genérica sin espesor calibrado para molduras de Peugeot</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">Tela automotriz foamizada nueva con tono y textura original OEM</td>
              </tr>
              <tr class="hover:bg-[#F9FAFB] transition-colors">
                <th scope="row" class="p-3.5 sm:p-4 font-bold text-[#111827]">Tiempo sin auto y traslado</th>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Trabajo incompleto sin desarme; dura semanas o días</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Inmoviliza el vehículo de 2 a 5 días en taller</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">Servicio en el día en tu cochera; listo en 3 a 4 horas</td>
              </tr>
              <tr class="hover:bg-[#F9FAFB] transition-colors">
                <th scope="row" class="p-3.5 sm:p-4 font-bold text-[#111827]">Cuidado de trabas y sensores</th>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Riesgo de quebrar grampas, plafones de luz y parasoles</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Desarme general sin herramientas dedicadas a Peugeot 307</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">Espátulas plásticas específicas para no marcar molduras ni romper trabas</td>
              </tr>
              <tr class="hover:bg-[#F9FAFB] transition-colors">
                <th scope="row" class="p-3.5 sm:p-4 font-bold text-[#111827]">Garantía documentada</th>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Sin garantía; resultado desprolijo</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB]">Variable según criterio de cada taller</td>
                <td class="p-3.5 sm:p-4 border-l border-[#E5E7EB] font-semibold text-[#111827] bg-[#F3F4F6]/60">Garantía escrita de 12 meses</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt-8 text-center sm:text-left">
          <a
            href={antesDespuesWaUrl}
            class="cta-whatsapp text-base w-full sm:w-auto"
            target="_blank"
            rel="noopener noreferrer"
            onclick={antesDespuesCTAHandler}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>Quiero Restaurar el Techo de mi Peugeot 307</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO A DOMICILIO (3 PASOS REALES CON FOTOS) -->
  <section class="py-12 lg:py-16 bg-[#F3F4F6] border-b border-[#E5E7EB]">
    <div class="max-w-5xl mx-auto px-4">
      <div class="mb-8">
        <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
          Proceso de retapizado a domicilio en 3 pasos
        </h2>
        <p class="text-base text-[#4B5563] max-w-3xl leading-relaxed">
          Realizamos el retapizado completo del techo de tu Peugeot 307 en tu cochera o garaje sin mover el vehiculo. Nuestro protocolo tecnico especializado asegura una colocacion limpia, rapida y sin riesgo de danos en clips o sensores electricos en solo 3 a 4 horas.
        </p>
      </div>

      <ol class="grid md:grid-cols-3 gap-6" role="list">
        <!-- Paso 1: Celular -->
        <li class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-5 sm:p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm flex items-center justify-center text-[#111827]">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
                  <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
