  <!-- ZONAS DE COBERTURA (SELECTOR AL FINAL: UNICA seccion con padding-bottom extra para el CTA flotante) -->
  <section class="max-w-5xl mx-auto px-4 py-12 lg:py-16 pb-24 md:pb-16">
    <div class="mb-8">
      <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
        Zonas de Cobertura a Domicilio
      </h2>
      <p class="text-base text-[#4B5563] max-w-2xl leading-relaxed">
        Seleccioná tu localidad en CABA, Gran Buenos Aires o La Plata para conocer los detalles del servicio y tiempos de llegada a tu domicilio.
      </p>
    </div>
    <div class="space-y-10">
      {regiones.map((region) => {
        const zonasRegion = region.slugs
          .map((slug) => zonas.find((z) => z.data.slug === slug))
          .filter((z): z is NonNullable<typeof z> => Boolean(z));
        return (
          <div>
            <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-[#111827] mb-4 pb-2 border-b border-[#E5E7EB] flex items-center justify-between">
              <span>{region.nombre}</span>
              <span class="text-xs font-normal text-[#4B5563]">{zonasRegion.length} zonas</span>
            </h3>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {zonasRegion.map((zona) => (
                <a
                  href={"/reparacion-techo-peugeot-307/" + zona.data.slug + "/"}
                  class="block bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-4 hover:border-[#111827] transition-colors"
                >
                  <div class="flex items-start justify-between gap-2 mb-1">
