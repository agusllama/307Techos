---
/**
 * [zona].astro
 * Pagina de destino dinamica por zona geografica.
 * Regla DOM: cero divs envolventes innecesarios (anti-div-soup).
 * Semantica nativa completa para table, breadcrumb y details/summary.
 * Todos los CTAs de WhatsApp usan waClickHandler() — sin logica inline duplicada.
 * Cero placeholders crudos [COMPLETAR] en el HTML renderizado.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ReviewsMarquee from '../components/ReviewsMarquee.astro';
import { siteUrl, whatsappNumber } from '../config/site';
import { waClickHandler } from '../lib/tracking';

export async function getStaticPaths() {
  const RESERVED_SLUGS = new Set([
    'blog',
    '404',
    'index',
    'llms.txt',
    'api',
    'images',
    'favicon.svg',
    'robots.txt',
    'sitemap-index.xml',
    'sitemap-0.xml',
  ]);
  const zonas = await getCollection('zonas');
  return zonas
    .filter((zona) => !RESERVED_SLUGS.has(zona.data.slug))
    .map((zona) => ({
      params: { zona: zona.data.slug },
      props: { zona },
    }));
}

const { zona } = Astro.props;
const { Content } = await render(zona);
const d = zona.data;

const isCaba = d.slug === 'capital-federal';
const isInterior = d.slug === 'interior-buenos-aires';

const enZona = isInterior ? 'en el Interior de Buenos Aires' : 'en ' + d.nombreZona;
const paraZona = isInterior ? 'para el Interior de Buenos Aires' : (isCaba ? 'para CABA' : 'para ' + d.nombreZona);

const canonicalUrl = siteUrl + '/' + d.slug + '/';
const heroWaUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(
  isInterior
    ? 'Hola! Vi el servicio en la web y consulto para retapizar el techo de mi Peugeot 307 en el Interior de Buenos Aires. Soy de (ciudad/localidad): ... Te adjunto foto del techo:'
    : 'Hola! Vi el servicio en la web y consulto para retapizar el techo de mi Peugeot 307 a domicilio en ' + d.nombreZona + '. Te adjunto foto del techo:'
);
const antesDespuesWaUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(
  isInterior
    ? 'Hola! Vi las fotos del retapizado del Peugeot 307 y quiero pedir presupuesto para el Interior de Buenos Aires. Mi localidad es: ... Te adjunto foto:'
    : 'Hola! Vi las fotos del retapizado del Peugeot 307 y quiero pedir presupuesto para hacerlo en ' + d.nombreZona + '. Te adjunto foto:'
);
const finalWaUrl = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(
  isInterior
    ? 'Hola! Quiero coordinar un turno para retapizar el techo de mi Peugeot 307 en el Interior de Buenos Aires. Soy de: ... Te adjunto foto:'
    : 'Hola! Quiero coordinar un turno para retapizar el techo de mi Peugeot 307 en ' + d.nombreZona + '. Te adjunto foto:'
);

// Handlers de tracking (sin duplicar logica inline)
const heroCTAHandler         = waClickHandler(d.nombreZona, 'hero');
const antesDespuesCTAHandler = waClickHandler(d.nombreZona, 'antes-despues');
const finalCTAHandler        = waClickHandler(d.nombreZona, 'final');

const baseTitleLong = 'Reparación de Techo Peugeot 307 en ' + d.nombreZona + ' a Domicilio';
const baseTitleShort = 'Techo Caído Peugeot 307 en ' + d.nombreZona + ' a Domicilio';
const baseTitleCompact = 'Techo Peugeot 307 en ' + d.nombreZona + ' a Domicilio';
const title = baseTitleLong.length <= 60 ? baseTitleLong : (baseTitleShort.length <= 60 ? baseTitleShort : baseTitleCompact);
const description = isInterior
  ? 'Retapizado de techo Peugeot 307 en el Interior de Bs. As. a domicilio. En el día, menos de 2 horas y garantía escrita. Hatchback 3 y 5 puertas.'
  : 'Retapizado de techo Peugeot 307 en ' + d.nombreZona + ' donde tengas el auto (calle, trabajo o cochera). Listo en menos de 2 horas. Hatchback 3 y 5 puertas.';

// Verificacion estricta para omitir casos de exito si contienen placeholders
const isCasoExitoValido = Boolean(
  d.casoExitoLocal &&
  d.casoExitoLocal.barrio &&
  !d.casoExitoLocal.barrio.includes('[COMPLETAR]') &&
  d.casoExitoLocal.resultado &&
  !d.casoExitoLocal.resultado.includes('[COMPLETAR]') &&
  !d.casoExitoLocal.problemaResuelto?.includes('[COMPLETAR]')
);

const RESERVED_SLUGS = new Set([
  'blog',
  '404',
  'index',
  'llms.txt',
  'api',
  'images',
  'favicon.svg',
  'robots.txt',
  'sitemap-index.xml',
  'sitemap-0.xml',
]);
const todasLasZonas = (await getCollection('zonas')).filter((z) => !RESERVED_SLUGS.has(z.data.slug));

// Misma agrupacion que el hub y la home. Se usan las 3 zonas mas cercanas
// dentro de la region para enlazado interno contextual.
const regiones = [
  { nombre: 'CABA y Zona Norte', slugs: ['capital-federal', 'vicente-lopez', 'san-isidro', 'general-san-martin', 'tigre', 'pilar'] },
  { nombre: 'Zona Oeste', slugs: ['la-matanza', 'moron', 'tres-de-febrero', 'ituzaingo'] },
  { nombre: 'Zona Sur y Gran La Plata', slugs: ['avellaneda', 'lanus', 'lomas-de-zamora', 'quilmes', 'berazategui', 'almirante-brown', 'esteban-echeverria', 'ezeiza-canning', 'florencio-varela', 'la-plata'] },
  { nombre: 'Costa Atlántica', slugs: ['partido-de-la-costa', 'san-bernardo', 'mar-de-ajo', 'pinamar', 'villa-gesell', 'mar-del-plata'] },
  { nombre: 'Interior de Buenos Aires', slugs: ['interior-buenos-aires'] },
];
const regionActual = regiones.find((r) => r.slugs.includes(d.slug));
const indiceZona = regionActual ? regionActual.slugs.indexOf(d.slug) : -1;
const candidateRelacionadas = regionActual && indiceZona >= 0
  ? regionActual.slugs
      .filter((slug) => slug !== d.slug)
      .sort((a, b) => Math.abs(regionActual.slugs.indexOf(a) - indiceZona) - Math.abs(regionActual.slugs.indexOf(b) - indiceZona))
      .slice(0, 3)
      .map((slug) => todasLasZonas.find((z) => z.data.slug === slug))
      .filter((z): z is NonNullable<typeof z> => Boolean(z))
  : [];

// Si la región tiene una sola zona (ej. Interior de Buenos Aires), enlazamos a nodos gateway
const zonasRelacionadas = candidateRelacionadas.length > 0
  ? candidateRelacionadas
  : ['pilar', 'la-plata', 'mar-del-plata']
      .map((slug) => todasLasZonas.find((z) => z.data.slug === slug))
      .filter((z): z is NonNullable<typeof z> => Boolean(z));

const puntosBeneficio = isCaba
  ? [
      {
        titulo: 'Cero tráfico y traslados',
        descripcion: 'No pierdas 2 horas cruzando la ciudad para dejar el auto en un taller. Nosotros vamos a tu puerta.',
      },
      {
        titulo: 'Donde tengas el auto',
        descripcion: 'Solo necesitamos espacio para abrir las puertas laterales y el baúl. Trabajamos en la calle, en el trabajo, cochera o estacionamiento.',
      },
      {
        titulo: 'No te quedás a pie',
        descripcion: 'Nosotros dejamos el techo como 0km en menos de 2 horas.',
      },
    ]
  : isInterior
  ? [
      {
        titulo: 'Llegamos a tu localidad',
        descripcion: 'No necesitás viajar cientos de kilómetros a Capital ni a La Plata. Coordinamos la visita a tu ciudad o paraje y acudimos donde tengas el auto.',
      },
      {
        titulo: 'Especialista exclusivo en 307',
        descripcion: 'Evitá tapiceros generalistas que improvisan con tu techo solar o usan gomaespuma que se vuelve a caer con el calor del verano.',
      },
      {
        titulo: 'Listo en menos de 2 horas',
        descripcion: 'Trabajo completo en el acto: saneado de matriz, tela automotriz poliéster no foamizada y rearmado perfecto sin dejar el auto tirado.',
      },
    ]
  : [
      {
        titulo: 'Sin mover el auto',
        descripcion: 'Evitá el riesgo y la incomodidad de manejar por la avenida o la autopista con la tela colgando sobre tu cabeza.',
      },
      {
        titulo: 'Donde tengas el auto',
        descripcion: 'Vamos directo a donde tengas el auto (calle, trabajo o cochera). Solo necesitamos menos de 2 horas para dejar tu techo como 0km.',
      },
      {
        titulo: 'Chau talleres lentos',
        descripcion: 'Te ahorrás el dolor de cabeza de dejar el auto tirado días enteros en un taller de barrio.',
      },
    ];

const corredoresInterior = [
  {
    ruta: 'RN 7 / RN 188',
    nombre: 'Corredor Noroeste',
    ciudades: 'Junín, Chacabuco, Vedia, Lincoln, General Pinto, Leandro N. Alem, General Villegas y parajes intermedios.',
  },
  {
    ruta: 'RN 5',
    nombre: 'Corredor Centro-Oeste',
    ciudades: 'Chivilcoy, Mercedes, Suipacha, Alberti, Bragado, 9 de Julio, Carlos Casares, Pehuajó, Trenque Lauquen y Pellegrini.',
  },
  {
    ruta: 'RN 8 / RN 9',
    nombre: 'Corredor Norte y Litoral',
    ciudades: 'Pergamino, Arrecifes, Capitán Sarmiento, Colón, Salto, Rojas, San Antonio de Areco, Carmen de Areco, Baradero y San Pedro.',
  },
  {
    ruta: 'RN 205 / RN 3',
    nombre: 'Corredor Sudoeste y Cuenca Central',
    ciudades: 'Lobos, Roque Pérez, Saladillo, General Alvear, Las Flores, Tapalqué, Azul, Olavarría, Laprida, General La Madrid, Coronel Pringles, Benito Juárez, Tres Arroyos y Bahía Blanca.',
  },
  {
    ruta: 'RP 226 / RP 29',
    nombre: 'Corredor Sierras',
    ciudades: 'Tandil, Balcarce, Ayacucho, Rauch, General Belgrano y parajes aledaños de la cuenca serrana.',
  },
  {
    ruta: 'RP 2 / RP 63',
    nombre: 'Corredor Autovía y Salado',
    ciudades: 'Chascomús, Lezama, Castelli, Dolores, Maipú y conexiones rurales.',
  },
];

const diferencialesInterior = [
  {
    numero: '01',
    titulo: 'Especialista Exclusivo en 307 (Techo Solar sin Roturas)',
    subtitulo: 'Por qué los tapiceros locales no suelen tomar el auto',
    descripcion: 'El 307 tiene una matriz plástica termoformada con tolerancias milimétricas que se quiebra si se desmonta sin espátulas automotrices específicas. En talleres tradicionales suelen pedir que desmontes el techo o inmovilizan el coche días improvisando con pegamentos universales. Nosotros llevamos instrumental OEM y repuestos de fijación exactos para desarmar, retapizar y rearmar en menos de 2 horas en tu propio garage.',
  },
  {
    numero: '02',
    titulo: 'Tela Automotriz No Foamizada (Resistencia a >65°C)',
    subtitulo: 'La solución definitiva al sol y calor del interior bonaerense',
    descripcion: 'Al dejar el auto en veredas anchas o campos abiertos en verano, el techo supera los 65°C. La gomaespuma original de fábrica se pudre por calor químico y se convierte en polvillo naranja pegajoso que suelta la tela. Nuestra tela es 100% fibra de poliéster automotriz sin capa de gomaespuma degradable, termo-adherida con adhesivo para más de 110°C: nunca más vuelve a caerse.',
  },
  {
    numero: '03',
    titulo: 'Presupuesto Cerrado por Foto en 15 Minutos',
    subtitulo: 'Cero sorpresas al momento de la visita',
    descripcion: 'Nos mandás una foto del techo desprendido por WhatsApp y en menos de 15 minutos te pasamos el presupuesto exacto y congelado para tu localidad. Coordinamos la fecha exacta del recorrido técnico y contás con 12 meses de garantía escrita documentada.',
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} zona={d} faq={true}>

  <!-- HERO MINIMALISTA: Fondo con la imagen real de Antes y Después + Overlay + Tipografía blanca + CTA WhatsApp -->
  <section class="relative min-h-[calc(100vh-130px)] min-h-[calc(100dvh-130px)] md:min-h-screen flex items-center justify-center overflow-hidden bg-[#111827] text-white border-b border-[#E5E7EB]">
    <!-- Imagen de fondo optimizada con carga prioritaria LCP -->
    <picture class="absolute inset-0 w-full h-full pointer-events-none">
      <source media="(max-width: 640px)" srcset="/images/hero-split-bg-mobile.webp" type="image/webp" width="750" height="1200" />
      <img
        src="/images/hero-split-bg.webp"
        alt={"Antes y después del retapizado de techo Peugeot 307 en " + d.nombreZona}
        width="1200"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center"
        style="aspect-ratio: 1200 / 800;"
      />
    </picture>

    <!-- Overlay con scrim funcional para legibilidad impecable y visualización del split antes/después -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#111827]/40 via-[#111827]/65 to-[#111827]/85 backdrop-blur-[0.5px]"></div>

    <!-- Indicadores discretos de Antes y Después sobre el fondo -->
    <div class="absolute top-3 sm:top-4 inset-x-3 sm:inset-x-4 flex justify-between items-center gap-2 pointer-events-none z-10">
      <span class="bg-black/60 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-sm border border-white/20 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white/80 whitespace-nowrap shrink-0">Antes: Caído</span>
      <span class="bg-black/60 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-sm border border-white/20 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-white/80 whitespace-nowrap shrink-0">Después: Restaurado</span>
    </div>

    <!-- Contenido Minimalista Centrado -->
    <div class="relative z-10 max-w-2xl mx-auto px-4 py-8 sm:py-20 text-center flex flex-col items-center">
      <h1 class="text-[22px] sm:text-5xl lg:text-6xl font-black uppercase tracking-tighter leading-[1.08] mb-3 text-white drop-shadow-sm">
        Techo Caído del Peugeot 307 {enZona}
      </h1>

      <p class="text-sm sm:text-base text-gray-200 max-w-xl mx-auto mb-6 leading-relaxed font-normal text-balance">
        {isInterior
          ? 'Como 0km sin mover tu auto: retapizado a domicilio en el interior bonaerense, sin olor a pegamento y sin que se vuelva a despegar con el calor.'
          : `Como 0km sin mover tu auto: retapizado a domicilio en ${d.nombreZona}, sin olor a pegamento y sin que se vuelva a despegar con el calor.`}
      </p>

      <!-- Trust Grid de 3 columnas unificado -->
      <div class="grid grid-cols-3 gap-1.5 sm:gap-4 w-full max-w-lg mb-6 p-2.5 sm:p-3 rounded-2xl bg-white/[0.08] backdrop-blur-md border border-white/15 shadow-lg">
        <!-- Columna 1: Rapidez -->
        <div class="flex flex-col items-center justify-center p-1 sm:p-2 text-center">
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/10 flex items-center justify-center mb-1 text-[#25D366] shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" style="aspect-ratio: 1/1;">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <span class="text-[10px] sm:text-xs font-black uppercase tracking-tight text-white leading-tight">En menos de 2 horas</span>
        </div>

        <!-- Columna 2: Ubicación -->
        <div class="flex flex-col items-center justify-center p-1 sm:p-2 text-center border-x border-white/10">
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/10 flex items-center justify-center mb-1 text-[#25D366] shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" style="aspect-ratio: 1/1;">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <span class="text-[11px] sm:text-sm font-black uppercase tracking-tight text-white leading-tight">A Domicilio</span>
          <span class="text-[10px] sm:text-xs text-gray-300 font-medium leading-tight">{isInterior ? 'Galpón, campo o casa' : 'Cochera o calle'}</span>
        </div>

        <!-- Columna 3: Garantía -->
        <div class="flex flex-col items-center justify-center p-1 sm:p-2 text-center">
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/10 flex items-center justify-center mb-1 text-[#25D366] shrink-0" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" style="aspect-ratio: 1/1;">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <span class="text-[11px] sm:text-sm font-black uppercase tracking-tight text-white leading-tight">12 Meses</span>
          <span class="text-[10px] sm:text-xs text-gray-300 font-medium leading-tight">Garantía escrita</span>
        </div>
      </div>

      <!-- Escasez pegada al botón con punto verde alineado con precisión -->
      <div class="inline-flex items-center justify-center gap-2 text-[11px] sm:text-xs font-bold uppercase tracking-tight sm:tracking-wider text-white/90 text-center mb-2.5">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#25D366]"></span>
        </span>
        <span class="leading-none">{isInterior ? 'Recorridos semanales · Cupos limitados por zona' : `Solo 2 turnos por semana en ${d.nombreZona}`}</span>
      </div>

      <!-- WhatsApp CTA Button Redesign -->
      <a
        href={heroWaUrl}
        class="cta-hero-whatsapp group relative w-full sm:w-auto inline-flex items-center justify-center gap-3 sm:gap-3.5 px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl text-[#0a2e16] mb-3 text-left min-h-[52px]"
        target="_blank"
        rel="noopener noreferrer"
        onclick={heroCTAHandler}
      >
        <div class="w-10 h-10 rounded-xl bg-white/20 border border-white/25 flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 transition-transform duration-150">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-[#0a2e16] shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </div>
        <div class="flex flex-col items-start text-left">
          <span class="text-sm sm:text-base font-black uppercase tracking-tight leading-tight text-[#0a2e16]">Cotizar por WhatsApp</span>
          <span class="text-[11px] sm:text-xs font-semibold tracking-normal text-[#0a2e16] leading-tight mt-0.5">Envianos foto de tu techo • Respuesta en 15 min</span>
        </div>
      </a>

      <!-- Reassurance estilo minimalista debajo del boton -->
      <p class="text-[11px] sm:text-xs text-gray-300 font-medium tracking-tight">
        {isInterior
          ? 'Presupuesto cerrado por foto en 15 min · 12 meses de garantía escrita'
          : 'Presupuesto sin cargo en el día · Sin seña, pagás recién al terminar.'}
      </p>
    </div>
  </section>

  <!-- MARQUEE DE RESEÑAS / SOCIAL PROOF GOOGLE MAPS -->
  <ReviewsMarquee />

  <!-- TRANSFORMACION VISUAL: ANTES VS DESPUES -->
  <section class="py-12 lg:py-16 bg-[#FFFFFF] border-b border-[#E5E7EB]">
    <div class="max-w-5xl mx-auto px-4">
      <div class="mb-8">
        <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
          Tu Techo como 0km {enZona}
        </h2>
        <p class="text-base text-[#4B5563] max-w-3xl leading-relaxed">
          El desprendimiento de la tela del techo en el Peugeot 307 {enZona} ocurre por la degradación natural de la espuma de fábrica bajo el calor. La solución profesional a domicilio reemplaza la tela completa por material nuevo automotriz fijado con adhesivo resistente a altas temperaturas sin mover tu auto.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-8">
        <!-- Tarjeta Antes -->
        <div class="border border-[#E5E7EB] bg-[#F3F4F6] rounded-sm flex flex-col justify-between overflow-hidden">
          <img
            src="/images/techo-antes-caido.webp"
            alt={"Techo caido de Peugeot 307 antes de reparar en " + d.nombreZona}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover aspect-[16/9] border-b border-[#E5E7EB]"
            style="aspect-ratio: 16 / 9;"
          />
          <div class="p-4 sm:p-5">
            <h3 class="text-xs font-black uppercase tracking-tight text-[#111827] mb-1.5">
              Antes: Tela suelta y polvillo naranja
            </h3>
            <p class="text-sm text-[#4B5563] leading-relaxed">
