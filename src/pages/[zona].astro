                    <h4 class="text-sm sm:text-base font-black uppercase tracking-tight text-[#111827] mb-1 leading-snug">
                      {dif.titulo}
                    </h4>
                    <p class="text-[11px] font-bold uppercase tracking-tight text-[#16A34A] mb-2.5">
                      {dif.subtitulo}
                    </p>
                    <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
                      {dif.descripcion}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      <div class="pt-6 border-t border-[#E5E7EB]">
        <h3 class="font-black text-[#111827] mb-3 text-xs uppercase tracking-tight">{isInterior ? 'Ciudades Cabecera, Corredores y Localidades con Cobertura' : 'Barrios y Localidades con Cobertura Activa'}</h3>
        <ul class="flex flex-wrap gap-2">
          {d.barriosCobertura.map((barrio) => (
            <li class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm px-3 py-1.5 text-xs text-[#111827] font-semibold">{barrio}</li>
          ))}
          <li class="bg-[#E5E7EB] border border-[#D1D5DB] rounded-sm px-3 py-1.5 text-xs text-[#111827] font-bold">Entre otros...</li>
        </ul>
        {d.viasAccesoPrincipales && d.viasAccesoPrincipales.length > 0 && (
          <div class="mt-4 pt-4 border-t border-[#E5E7EB]">
            <h4 class="font-black text-[#111827] mb-2 text-xs uppercase tracking-tight">{isInterior ? 'Rutas y Corredores Viales Principales' : 'Vías de Acceso Principales'}</h4>
            <ul class="flex flex-wrap gap-2">
              {d.viasAccesoPrincipales.map((via) => (
                <li class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm px-3 py-1.5 text-xs text-[#4B5563] font-medium">{via}</li>
              ))}
            </ul>
          </div>
        )}
        {isInterior && (
          <p class="mt-4 text-xs text-[#4B5563] bg-[#F9FAFB] border border-[#E5E7EB] p-3 rounded-sm leading-relaxed">
            <strong class="text-[#111827]">¿Tu pueblo, paraje o quinta no figura en la lista?</strong> Llegamos a cualquier punto del interior de la provincia de Buenos Aires a través de nuestros recorridos programados. <a href={heroWaUrl} class="text-[#16A34A] font-bold hover:underline" target="_blank" rel="noopener noreferrer">Consultanos por WhatsApp con tu localidad</a> y coordinamos la fecha.
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- CASO DE EXITO LOCAL (Omitido automaticamente si contiene placeholders) -->
  {isCasoExitoValido && (
    <section class="max-w-5xl mx-auto px-4 py-12 lg:py-16 border-b border-[#E5E7EB]">
      <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">Caso Real {enZona}</h2>
      <p class="text-base text-[#4B5563] mb-6 max-w-2xl leading-relaxed">Cada trabajo ejecutado deja registro tecnico del modelo, el barrio, el problema encontrado y el resultado obtenido.</p>
      <article class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-5">
        <dl class="space-y-3">
          <div class="grid sm:grid-cols-3 gap-1 pb-2 border-b border-[#E5E7EB]">
            <dt class="font-bold text-[#4B5563] text-xs uppercase tracking-tight">Modelo</dt>
            <dd class="sm:col-span-2 text-[#111827] font-semibold text-sm">{d.casoExitoLocal.modeloDetalle}</dd>
          </div>
          <div class="grid sm:grid-cols-3 gap-1 pb-2 border-b border-[#E5E7EB]">
            <dt class="font-bold text-[#4B5563] text-xs uppercase tracking-tight">{isInterior ? 'Localidad' : 'Barrio'}</dt>
            <dd class="sm:col-span-2 text-[#111827] font-semibold text-sm">{d.casoExitoLocal.barrio}</dd>
          </div>
          <div class="grid sm:grid-cols-3 gap-1 pb-2 border-b border-[#E5E7EB]">
            <dt class="font-bold text-[#4B5563] text-xs uppercase tracking-tight">Problema</dt>
            <dd class="sm:col-span-2 text-[#4B5563] text-sm">{d.casoExitoLocal.problemaResuelto}</dd>
          </div>
          <div class="grid sm:grid-cols-3 gap-1">
            <dt class="font-bold text-[#4B5563] text-xs uppercase tracking-tight">Resultado</dt>
            <dd class="sm:col-span-2 text-[#111827] font-semibold text-sm">{d.casoExitoLocal.resultado}</dd>
          </div>
        </dl>
      </article>
    </section>
  )}

  <!-- FAQ (details/summary nativo — cero JS) -->
  <section class="py-12 lg:py-16 bg-[#FFFFFF] border-b border-[#E5E7EB]">
    <div class="max-w-3xl mx-auto px-4">
      <div class="mb-8">
        <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
          Preguntas Frecuentes
        </h2>
        <p class="text-base text-[#4B5563] leading-relaxed">
          Respondemos las dudas más frecuentes de propietarios de Peugeot 307 {enZona} sobre el procedimiento de retapizado donde tengas el auto, los materiales utilizados y la coordinación del servicio.
        </p>
      </div>

      <div class="space-y-3">
        <details class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="font-bold text-sm sm:text-base text-[#111827] cursor-pointer flex justify-between items-center min-h-[44px]">
            <span>¿Cuánto tiempo demora el trabajo?</span>
            <span class="text-[#4B5563] font-mono text-lg ml-2 shrink-0">+</span>
          </summary>
          <p class="text-xs sm:text-sm text-[#4B5563] mt-3 pt-3 border-t border-[#E5E7EB] leading-relaxed">
            Menos de 2 horas (según versión con o sin techo solar). Lo hacemos y lo terminamos en el día para que no te quedes a pie.
          </p>
        </details>

        <details class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="font-bold text-sm sm:text-base text-[#111827] cursor-pointer flex justify-between items-center min-h-[44px]">
            <span>¿El adhesivo resiste el calor del verano?</span>
            <span class="text-[#4B5563] font-mono text-lg ml-2 shrink-0">+</span>
          </summary>
          <p class="text-xs sm:text-sm text-[#4B5563] mt-3 pt-3 border-t border-[#E5E7EB] leading-relaxed">
            Sí. Utilizamos exclusivamente adhesivo de contacto de grado automotriz diseñado para soportar calor extremo y humedad sin volver a despegarse.
          </p>
        </details>

        <details class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="font-bold text-sm sm:text-base text-[#111827] cursor-pointer flex justify-between items-center min-h-[44px]">
            <span>¿Qué espacio se necesita en el domicilio?</span>
            <span class="text-[#4B5563] font-mono text-lg ml-2 shrink-0">+</span>
          </summary>
          <p class="text-xs sm:text-sm text-[#4B5563] mt-3 pt-3 border-t border-[#E5E7EB] leading-relaxed">
            Muy poco. Solo necesitamos el espacio suficiente para poder abrir las puertas y el baúl por completo. Trabajamos donde tengas el auto: en la calle, en el trabajo, cochera o estacionamiento.
          </p>
        </details>

        <details class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="font-bold text-sm sm:text-base text-[#111827] cursor-pointer flex justify-between items-center min-h-[44px]">
            <span>¿El servicio cuenta con garantía?</span>
            <span class="text-[#4B5563] font-mono text-lg ml-2 shrink-0">+</span>
          </summary>
          <p class="text-xs sm:text-sm text-[#4B5563] mt-3 pt-3 border-t border-[#E5E7EB] leading-relaxed">
            Sí, te damos una garantía escrita por 12 meses.
          </p>
        </details>

        <details class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="font-bold text-sm sm:text-base text-[#111827] cursor-pointer flex justify-between items-center min-h-[44px]">
            <span>¿Qué medios de pago aceptan?</span>
            <span class="text-[#4B5563] font-mono text-lg ml-2 shrink-0">+</span>
          </summary>
          <p class="text-xs sm:text-sm text-[#4B5563] mt-3 pt-3 border-t border-[#E5E7EB] leading-relaxed">
            Aceptamos efectivo y transferencia bancaria. Abonás recién cuando el trabajo está terminado y revisado a tu total conformidad.
          </p>
        </details>

        <details class="bg-[#F3F4F6] border border-[#E5E7EB] rounded-sm p-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="font-bold text-sm sm:text-base text-[#111827] cursor-pointer flex justify-between items-center min-h-[44px]">
            <span>¿Puedo usar el auto inmediatamente después?</span>
            <span class="text-[#4B5563] font-mono text-lg ml-2 shrink-0">+</span>
          </summary>
          <p class="text-xs sm:text-sm text-[#4B5563] mt-3 pt-3 border-t border-[#E5E7EB] leading-relaxed">
            Sí, el auto queda listo para manejar apenas nos vamos, sin tiempos extra de secado.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- GUÍAS TÉCNICAS RELACIONADAS -->
  <section class="max-w-4xl mx-auto px-4 py-10 border-b border-[#E5E7EB]">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#111827] mb-1">
          Guías Técnicas y Consejos para Peugeot 307
        </h2>
        <p class="text-xs sm:text-sm text-[#4B5563]">
          Información práctica sobre las causas del desprendimiento de tela y mantenimiento del techo en {d.nombreZona}.
        </p>
      </div>
      <a href="/blog/" class="text-xs font-bold uppercase tracking-tight text-[#111827] hover:underline transition-colors inline-flex items-center min-h-[44px] py-1 shrink-0">
        Ver todas las guías del blog
      </a>
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
      <a
        href="/blog/techo-caido-peugeot-307-vtv/"
        class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-4 hover:border-[#111827] transition-colors flex flex-col justify-between"
      >
        <div>
          <h3 class="text-sm font-black uppercase tracking-tight text-[#111827] mb-1.5">
            ¿Te pueden rebotar la VTV por el techo caído en un 307?
          </h3>
          <p class="text-xs text-[#4B5563] leading-relaxed mb-3">
            Riesgos de rechazo en plantas de CABA y Provincia, visibilidad obstruida y solución express antes de tu turno.
          </p>
        </div>
        <div class="pt-2 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#4B5563]">
          <span>VTV y Trámites</span>
          <span class="font-bold uppercase tracking-tight text-[#111827]">Leer guía</span>
        </div>
      </a>

      <a
        href="/blog/por-que-se-cae-techo-peugeot-307/"
        class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-4 hover:border-[#111827] transition-colors flex flex-col justify-between"
      >
        <div>
          <h3 class="text-sm font-black uppercase tracking-tight text-[#111827] mb-1.5">
            ¿Por qué se cae el techo del Peugeot 307 y solución definitiva?
          </h3>
          <p class="text-xs text-[#4B5563] leading-relaxed mb-3">
            Por qué la espuma original de fábrica se desintegra con el calor y cómo evitar fallas con pegamentos caseros.
          </p>
        </div>
        <div class="pt-2 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#4B5563]">
          <span>Diagnóstico y Solución</span>
          <span class="font-bold uppercase tracking-tight text-[#111827]">Leer guía</span>
        </div>
      </a>

      <a
        href="/blog/techo-solar-panoramico-peugeot-307-tapizado/"
        class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-4 hover:border-[#111827] transition-colors flex flex-col justify-between"
      >
        <div>
          <h3 class="text-sm font-black uppercase tracking-tight text-[#111827] mb-1.5">
            Techo solar del 307 Hatchback: cuidados y tapizado
          </h3>
          <p class="text-xs text-[#4B5563] leading-relaxed mb-3">
            Precauciones para reparar el techo corredizo sin romper el mecanismo ni tapar los desagües pluviales.
          </p>
        </div>
        <div class="pt-2 border-t border-[#E5E7EB] flex items-center justify-between text-xs text-[#4B5563]">
          <span>Techo Solar</span>
          <span class="font-bold uppercase tracking-tight text-[#111827]">Leer guía</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ENLAZADO INTERNO: hub + zonas cercanas -->
  {zonasRelacionadas.length > 0 && (
    <section class="max-w-4xl mx-auto px-4 py-10 border-b border-[#E5E7EB]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#111827] mb-1">
            Zonas Cercanas con Cobertura
          </h2>
          <p class="text-xs sm:text-sm text-[#4B5563]">
            También atendemos a domicilio en localidades vecinas a {d.nombreZona}.
          </p>
        </div>
        <a href="/#zonas" class="text-xs font-bold uppercase tracking-tight text-[#111827] hover:underline transition-colors inline-flex items-center min-h-[44px] py-1 shrink-0">
          Ver todas las zonas
        </a>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        {zonasRelacionadas.map((z) => (
          <a
            href={"/" + z.data.slug + "/"}
            class="bg-[#FFFFFF] border border-[#E5E7EB] rounded-sm p-4 hover:border-[#111827] transition-colors flex flex-col justify-between"
          >
            <p class="font-black text-sm uppercase tracking-tight text-[#111827] mb-1">{z.data.nombreZona}</p>
            <p class="text-xs text-[#4B5563] leading-relaxed">{z.data.barriosCobertura.slice(0, 3).join(', ')} y alrededores.</p>
            <span class="pt-2 mt-2 border-t border-[#E5E7EB] text-[11px] font-bold uppercase tracking-tight text-[#4B5563]">Llegada: {z.data.tiempoLlegadaEstimado}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- CTA FINAL (ÚLTIMA SECCIÓN ANTES DEL FOOTER: UNICA seccion con padding-bottom extra para el CTA flotante) -->
  <section class="max-w-4xl mx-auto px-4 py-12 lg:py-16 pb-24 md:pb-16 text-center">
    <h2 class="text-[24px] lg:text-3xl font-black uppercase tracking-tighter leading-[1.2] text-[#111827] mb-3">
      Resolvelo Hoy {enZona}
    </h2>
    <p class="text-base text-[#4B5563] mb-6 max-w-lg mx-auto leading-relaxed">
      {isInterior
        ? 'Sin turno previo para la consulta inicial. Evaluamos el estado del techo de tu Peugeot 307 por WhatsApp y coordinamos la fecha del próximo recorrido por tu zona.'
        : 'Sin turno previo para la consulta inicial. Evaluamos el estado del techo de tu Peugeot 307 por WhatsApp y coordinamos el horario que mejor se adapte a tu agenda.'}
    </p>
    <a
      href={finalWaUrl}
      class="cta-hero-whatsapp group relative w-full sm:w-auto inline-flex items-center justify-center gap-3 sm:gap-3.5 px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl text-[#0a2e16] mb-3 text-left min-h-[52px]"
      target="_blank"
      rel="noopener noreferrer"
      onclick={finalCTAHandler}
    >
      <div class="w-10 h-10 rounded-xl bg-white/20 border border-white/25 flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 transition-transform duration-150">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-[#0a2e16] shrink-0" aria-hidden="true" style="aspect-ratio: 1/1;">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </div>
      <div class="flex flex-col items-start text-left">
        <span class="text-sm sm:text-base font-black uppercase tracking-tight leading-tight text-[#0a2e16]">Cotizar por WhatsApp</span>
        <span class="text-[11px] sm:text-xs font-semibold tracking-normal text-[#0a2e16] leading-tight mt-0.5">Envianos foto de tu techo • Respuesta en 15 min</span>
      </div>
    </a>
    <p class="text-xs text-[#4B5563] mt-3">
      {isInterior
        ? 'Atención a domicilio en todas las localidades y corredores del interior de Buenos Aires. Coordinación directa por WhatsApp.'
        : `Atención a domicilio en ${d.nombreZona} y alrededores. Coordinación directa por WhatsApp.`}
    </p>
  </section>
</Layout>