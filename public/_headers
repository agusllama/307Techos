# =====================================================
# Cloudflare Pages — Headers de caché y seguridad
# 307 Techos · 307techos.com.ar
# =====================================================

# Assets de Astro: hashes en el nombre → immutable 1 año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes estáticas
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400

# Evitar que el subdominio temporal workers.dev indexe como duplicado en Google
https://307techos.agusllama1.workers.dev/*
  X-Robots-Tag: noindex, nofollow

# HTML pages: sin cache en CDN (Cloudflare gestiona con su caché inteligente)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
